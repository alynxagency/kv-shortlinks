// Copy to wrangler.jsonc (gitignored) and fill in your values.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kv-shortlinks",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	"workers_dev": false,
	"preview_urls": false,
	"vars": {
		// Where "/" redirects. Empty string: "/" returns 404.
		"ROOT_URL": "https://example.com/"
	},
	// Only listed hostnames reach the Worker. Add "www.example.com/*" to serve www too.
	"routes": [
		{
			"pattern": "example.com/*",
			"zone_name": "example.com"
		}
	],
	"kv_namespaces": [
		{
			"binding": "LINKS",
			// From `bunx wrangler kv namespace create LINKS`.
			"id": "<KV_NAMESPACE_ID>"
		}
	]
}
